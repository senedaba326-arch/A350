<?xml version="1.0" encoding="UTF-8"?>
<PropertyList include="A350-common.xml">
  <sim>
    <description>Airbus A350-900 — GPL community flight-simulator model</description>
    <author>FlightGear A350 community contributors; see THIRD_PARTY_NOTICES.md</author>
    <status>alpha</status>
    <rating>
      <FDM type="int">2</FDM>
      <systems type="int">2</systems>
      <cockpit type="int">3</cockpit>
      <model type="int">4</model>
    </rating>
    <aircraft-version type="string">0.2.0</aircraft-version>
    <minimum-fg-version type="string">2020.3</minimum-fg-version>
    <flight-model>jsb</flight-model>
    <aero>A350</aero>
    <model path="Aircraft/A350/Models/A350XWB-900.xml"/>
    <tags>
      <tag>airliner</tag>
      <tag>twin-engine</tag>
      <tag>widebody</tag>
    </tags>
  </sim>
  <nasal>
    <load>
      <file>Aircraft/A350/Nasal/electrical.nas</file>
      <file>Aircraft/A350/Nasal/hydraulics.nas</file>
      <file>Aircraft/A350/Nasal/flight-controls.nas</file>
      <file>Aircraft/A350/Nasal/pneumatics.nas</file>
      <file>Aircraft/A350/Nasal/systems.nas</file>
      <file>Aircraft/A350/Nasal/display.nas</file>
    </load>
  </nasal>
  <input>
    <keyboard>
      <key n="101">
        <name>e</name>
        <binding>
          <command>nasal</command>
          <script>A350Display.toggle();</script>
        </binding>
      </key>
      <key n="66">
        <name>B</name>
        <desc>Toggle parking brake</desc>
        <binding>
          <command>property-toggle</command>
          <property>controls/gear/brake-parking</property>
        </binding>
      </key>
      <key n="69">
        <name>E</name>
        <desc>Toggle simulated external power</desc>
        <binding>
          <command>nasal</command>
          <script>A350Systems.toggleExternalPower();</script>
        </binding>
      </key>
    </keyboard>
  </input>
</PropertyList>
