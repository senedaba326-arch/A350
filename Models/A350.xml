<?xml version="1.0" encoding="UTF-8"?>
<PropertyList>
  <path>A350.ac</path>
  <animation>
    <type>rotate</type>
    <object-name>Elevator_L</object-name>
    <object-name>Elevator_R</object-name>
    <property>fcs/elevator-pos-norm</property>
    <factor>18</factor>
    <center><x-m>31.5</x-m><y-m>-4.0</y-m><z-m>0</z-m></center>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>Aileron_L</object-name>
    <property>fcs/left-aileron-pos-norm</property>
    <factor>18</factor>
    <center><x-m>5.8</x-m><y-m>0.4</y-m><z-m>-25.5</z-m></center>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>Aileron_R</object-name>
    <property>fcs/right-aileron-pos-norm</property>
    <factor>18</factor>
    <center><x-m>5.8</x-m><y-m>0.4</y-m><z-m>25.5</z-m></center>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>Flap_L</object-name>
    <object-name>Flap_R</object-name>
    <property>fcs/flap-pos-norm</property>
    <factor>24</factor>
    <center><x-m>6.5</x-m><y-m>0.2</y-m><z-m>0</z-m></center>
    <axis><x>0</x><y>0</y><z>1</z></axis>
  </animation>
  <animation>
    <type>rotate</type>
    <object-name>Rudder</object-name>
    <property>fcs/rudder-pos-norm</property>
    <factor>25</factor>
    <center><x-m>32</x-m><y-m>-8</y-m><z-m>0</z-m></center>
    <axis><x>0</x><y>-1</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>NoseGear</object-name>
    <object-name>NoseWheel</object-name>
    <property>gear/gear-pos-norm</property>
    <factor>-2.5</factor>
    <offset-m>2.5</offset-m>
    <axis><x>0</x><y>-1</y><z>0</z></axis>
  </animation>
  <animation>
    <type>translate</type>
    <object-name>MainGear_L</object-name>
    <object-name>MainGear_R</object-name>
    <object-name>MainWheel_L_A</object-name>
    <object-name>MainWheel_L_B</object-name>
    <object-name>MainWheel_R_A</object-name>
    <object-name>MainWheel_R_B</object-name>
    <property>gear/gear-pos-norm</property>
    <factor>-2.2</factor>
    <offset-m>2.2</offset-m>
    <axis><x>0</x><y>-1</y><z>0</z></axis>
  </animation>
</PropertyList>
